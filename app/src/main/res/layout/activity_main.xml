<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/app_name"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_tunnel"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/tunnel_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_tunnel"
            android:importantForAutofill="no"
            android:inputType="text"
            android:singleLine="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/label_ssids"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/home_ssids"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:hint="@string/hint_ssids"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textNoSuggestions"
            android:minLines="3" />

        <Switch
            android:id="@+id/enabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/label_enabled" />

        <Button
            android:id="@+id/save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/btn_save" />

        <Button
            android:id="@+id/grant"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_grant" />

        <Button
            android:id="@+id/open_wireguard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_open_wg" />

        <Button
            android:id="@+id/wg_battery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_wg_battery" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="monospace"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/help"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
